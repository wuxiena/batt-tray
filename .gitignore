# --- zig toolchain & build cache (large, download separately) ---
/toolchain/
/.zigcache/
/zig-cache/
/zig-out/

# --- build output (dist/ holds the committed prebuilt binary) ---
/*.exe
/*.pdb
/*.obj
/*.res
*.o
/tools/*.exe
/tools/*.pdb
/build/

# --- local debugging artifacts ---
*.log
/*_dbg.exe
/*_sim.exe
/shots/
/shots_multi/
/*.png
dist/*-diag.txt
diag.txt

# --- OS / editor ---
Thumbs.db
desktop.ini
.DS_Store
.vscode/
.idea/
*.swp

# 在 git-bash 里误用 `>nul` 会真的生成一个名为 nul 的文件，
# 而 Windows 不允许按普通文件名删除它，先忽略掉。
/nul
